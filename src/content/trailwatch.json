      "children": [
        {
          "id": "148:607",
          "name": "Case study / Narrative section",
          "w": 524,
          "h": 163,
          "layout": "VERTICAL",
          "children": [
            {
              "id": "I148:607;147:265",
              "name": "Project section",
              "w": 524,
              "h": 55,
              "text": "The direction I explored",
              "font": {
                "family": "Instrument Serif",
                "style": "Regular"
              },
              "size": 38,
              "link": null
            },
            {
              "id": "I148:607;147:266",
              "name": "Project story",
              "w": 524,
              "h": 100,
              "text": "Soft greens, warm neutrals, and landscape-like textures give the interface an outdoor feel. The concept connects a trail overview with simple observation inputs and past notes, making a small act of noticing the center of the experience.",
              "font": {
                "family": "Inter",
                "style": "Regular",
                "variationSettings": {
                  "wght": 400,
                  "slnt": 0
                }
              },
              "size": 17,
              "link": null
            }
          ]
        },
        {
          "id": "148:610",
          "name": "Case study / Narrative section",
          "w": 524,
          "h": 188,
          "layout": "VERTICAL",
          "children": [
            {
              "id": "I148:610;147:265",
              "name": "Project section",
              "w": 524,
              "h": 55,
              "text": "An exploration with room to grow",
              "font": {
                "family": "Instrument Serif",
                "style": "Regular"
              },
              "size": 38,
              "link": null
            },
            {
              "id": "I148:610;147:266",
              "name": "Project story",
              "w": 524,
              "h": 125,
              "text": "This was a personal design exercise rather than a full research-led UX project. I focused on the screens and visual direction. A next step would be to talk with walkers and hikers, test an observation flow outdoors, and learn which information they would actually want to record.",
              "font": {
                "family": "Inter",
                "style": "Regular",
                "variationSettings": {
                  "wght": 400,
                  "slnt": 0
                }
              },
              "size": 17,
              "link": null
            }
          ]
        }
      ]
