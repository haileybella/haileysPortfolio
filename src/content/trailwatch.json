        {
          "id": "I148:593;147:265",
          "name": "Project section",
          "w": 1088,
          "h": 55,
          "text": "It started with wanting to make something",
          "font": {
            "family": "Instrument Serif",
            "style": "Regular"
          },
          "size": 38,
          "link": null
        },
        {
          "id": "I148:593;147:266",
          "name": "Project story",
          "w": 1088,
          "h": 50,
          "text": "I made TrailWatch for fun, inspired by the idea of encouraging people to spend more time outside. It became a mobile interface for noticing changes along a local trail and keeping a record of what you see.",
          "font": {
            "family": "Inter",
            "style": "Regular",
            "variationSettings": {
              "wght": 400,
              "slnt": 0
            }
          },
          "size": 17,
          "link": null
        }
      ]
    },
