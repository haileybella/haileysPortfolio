    {
      "id": "148:525",
      "name": "The idea",
      "w": 1088,
      "h": 188,
      "layout": "HORIZONTAL",
      "children": [
        {
          "id": "148:526",
          "name": "Case study / Narrative section",
          "w": 524,
          "h": 163,
          "layout": "VERTICAL",
          "children": [
            {
              "id": "I148:526;147:265",
              "name": "Project section",
              "w": 524,
              "h": 55,
              "text": "From “what should I build?”",
              "font": {
                "family": "Instrument Serif",
                "style": "Regular"
              },
              "size": 38,
              "link": null
            },
            {
              "id": "I148:526;147:266",
              "name": "Project story",
              "w": 524,
              "h": 100,
              "text": "Technical learners have plenty of tutorials, repositories, and AI tools. The harder part can be choosing a project, knowing where to start, and following through. Our team built BluePrint to turn that uncertainty into a project with a direction.",
              "font": {
                "family": "Inter",
                "style": "Regular",
                "variationSettings": {
                  "wght": 400,
                  "slnt": 0
                }
              },
              "size": 17,
              "link": null
            }
          ]
        },
        {
          "id": "148:529",
          "name": "Case study / Narrative section",
          "w": 524,
          "h": 188,
          "layout": "VERTICAL",
          "children": [
            {
              "id": "I148:529;147:265",
              "name": "Project section",
              "w": 524,
              "h": 55,
              "text": "My part in the process",
              "font": {
                "family": "Instrument Serif",
                "style": "Regular"
              },
              "size": 38,
              "link": null
            },
            {
              "id": "I148:529;147:266",
              "name": "Project story",
              "w": 524,
              "h": 125,
              "text": "I explored roughly four design iterations during the hackathon, working through wireframes and competing visual directions in Figma. The interface evolved toward a stronger identity inspired by the event’s heist theme: each project becomes a mission with a plan.",
              "font": {
                "family": "Inter",
                "style": "Regular",
                "variationSettings": {
                  "wght": 400,
                  "slnt": 0
                }
              },
              "size": 17,
              "link": null
            }
          ]
        }
      ]
    },
    {
      "id": "148:532",
      "name": "Case study / Narrative section",
      "w": 1088,
      "h": 113,
      "layout": "VERTICAL",
      "children": [
        {
          "id": "I148:532;147:265",
          "name": "Project section",
          "w": 1088,
          "h": 55,
          "text": "Guidance that keeps the learner involved",
          "font": {
            "family": "Instrument Serif",
            "style": "Regular"
          },
          "size": 38,
          "link": null
        },
        {
          "id": "I148:532;147:266",
          "name": "Project story",
          "w": 1088,
          "h": 50,
          "text": "BluePrint connects project discovery, planning, mentorship, and progress tracking. The central design principle is to help someone understand their next step while keeping them responsible for building the project.",
          "font": {
            "family": "Inter",
            "style": "Regular",
            "variationSettings": {
              "wght": 400,
              "slnt": 0
            }
          },
          "size": 17,
          "link": null
        }
      ]
    },
