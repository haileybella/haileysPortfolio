      "layout": "VERTICAL",
      "children": [
        {
          "id": "I148:555;147:265",
          "name": "Project section",
          "w": 1088,
          "h": 55,
          "text": "Turning a plan into something actionable",
          "font": {
            "family": "Instrument Serif",
            "style": "Regular"
          },
          "size": 38,
          "link": null
        },
        {
          "id": "I148:555;147:266",
          "name": "Project story",
          "w": 1088,
          "h": 75,
          "text": "The team built the web application with Next.js, TypeScript, and Tailwind CSS. GitHub data supports project discovery; Gemini supports planning and mentorship; ElevenLabs adds voice interaction. Project dashboards bring tasks and progress into the same experience.",
          "font": {
            "family": "Inter",
            "style": "Regular",
            "variationSettings": {
              "wght": 400,
              "slnt": 0
            }
          },
          "size": 17,
          "link": null
        }
      ]
    },
