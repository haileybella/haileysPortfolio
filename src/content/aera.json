      "children": [
        {
          "id": "108:524",
          "name": "Overview",
          "w": 620,
          "h": 404,
          "layout": "VERTICAL",
          "children": [
            {
              "id": "108:525",
              "name": "Dear reader,",
              "w": 620,
              "h": 55,
              "text": "Dear reader,",
              "font": {
                "family": "Instrument Serif",
                "style": "Italic"
              },
              "size": 38,
              "link": null
            },
            {
              "id": "108:526",
              "name": "I attended the 2026 AERA Annual Meeting in Los Angeles—my first research conference! Being part of such a large gathering of researchers and educators gave me a wider view of the questions shaping education. Sessions on AI, ethics, and K–12 computing education connected closely to my interests in AI literacy. They pushed me to think about how we can help students understand what AI is, question its limitations, and consider its impact on people and communities. I also connected with a fellow Pathways scholar in graduate school. That conversation made the conference feel more personal and gave me space to reflect on my own path in research. I left grateful, curious, and with plenty of new questions.",
              "w": 620,
              "h": 325,
              "text": "I attended the 2026 AERA Annual Meeting in Los Angeles—my first research conference! Being part of such a large gathering of researchers and educators gave me a wider view of the questions shaping education.\n\nSessions on AI, ethics, and K–12 computing education connected closely to my interests in AI literacy. They pushed me to think about how we can help students understand what AI is, question its limitations, and consider its impact on people and communities.\n\nI also connected with a fellow Pathways scholar in graduate school. That conversation made the conference feel more personal and gave me space to reflect on my own path in research. I left grateful, curious, and with plenty of new questions.",
              "font": {
                "family": "Inter",
                "style": "Regular",
                "variationSettings": {
                  "wght": 400,
                  "slnt": 0
                }
              },
              "size": 17,
              "link": null
            }
          ]
        },
        {
          "id": "108:528",
          "name": "Highlights",
          "w": 380,
          "h": 379,
          "layout": "VERTICAL",
          "children": [
            {
              "id": "108:529",
              "name": "The moments I’m keeping",
              "w": 380,
              "h": 55,
              "text": "The moments I’m keeping",
              "font": {
                "family": "Instrument Serif",
                "style": "Regular"
              },
              "size": 38,
              "link": null
            },
            {
              "id": "108:530",
              "name": "Exploring how AI ethics connects classroom learning to broader social, environmental, and economic questions. Considering how generative AI in creative writing and schoolwork might affect equity, creativity, and student well-being—even when tools are presented as safe or helpful. Hearing how AI could support inquiry and reflection, while recognizing why students need room for their own ideas and judgment.",
              "w": 380,
              "h": 300,
              "text": "Exploring how AI ethics connects classroom learning to broader social, environmental, and economic questions.\n\nConsidering how generative AI in creative writing and schoolwork might affect equity, creativity, and student well-being—even when tools are presented as safe or helpful.\n\nHearing how AI could support inquiry and reflection, while recognizing why students need room for their own ideas and judgment.",
              "font": {
                "family": "Inter",
                "style": "Regular",
                "variationSettings": {
                  "wght": 400,
                  "slnt": 0
                }
              },
              "size": 17,
              "link": null
            }
          ]
        }
