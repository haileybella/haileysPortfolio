        {
          "id": "I209:574;147:266",
          "name": "Project story",
          "w": 1088,
          "h": 75,
          "text": "I designed a user-friendly iOS app and responsive website for a public art museum. The project aimed to strengthen its digital presence, helping visitors discover exhibitions and events, access museum information, and schedule visits. The website considered both desktop and mobile users, with all prototyping completed in Figma.",
          "font": {
            "family": "Inter",
            "style": "Regular",
            "variationSettings": {
              "wght": 400,
              "slnt": 0
            }
          },
          "size": 17,
          "link": null
        }
      ]
    },
    {
      "id": "148:429",
      "name": "Context and intention",
      "w": 1088,
      "h": 163,
      "layout": "HORIZONTAL",
      "children": [
        {
          "id": "148:430",
          "name": "Case study / Narrative section",
          "w": 524,
          "h": 163,
          "layout": "VERTICAL",
          "children": [
            {
              "id": "I148:430;147:265",
              "name": "Project section",
              "w": 524,
              "h": 55,
              "text": "Problem",
              "font": {
                "family": "Instrument Serif",
                "style": "Regular"
              },
              "size": 38,
              "link": null
            },
            {
              "id": "I148:430;147:266",
              "name": "Project story",
              "w": 524,
              "h": 100,
              "text": "Visitors can struggle to navigate museum websites and apps, find exhibition and event information in one place, and understand how to schedule a visit. I focused on making those paths clearer, especially the homepage and ticket-booking flow.",
              "font": {
                "family": "Inter",
                "style": "Regular",
                "variationSettings": {
                  "wght": 400,
                  "slnt": 0
                }
              },
              "size": 17,
              "link": null
            }
          ]
        },
        {
          "id": "148:433",
          "name": "Case study / Narrative section",
          "w": 524,
          "h": 163,
          "layout": "VERTICAL",
          "children": [
            {
              "id": "I148:433;147:265",
              "name": "Project section",
              "w": 524,
              "h": 55,
              "text": "Goals",
              "font": {
                "family": "Instrument Serif",
                "style": "Regular"
              },
              "size": 38,
              "link": null
            },
            {
              "id": "I148:433;147:266",
              "name": "Project story",
              "w": 524,
              "h": 100,
              "text": "Create a cohesive, intuitive app and responsive website. Present exhibitions and events clearly and creatively to encourage exploration, and simplify visit scheduling so visitors can plan with confidence.",
              "font": {
                "family": "Inter",
                "style": "Regular",
                "variationSettings": {
                  "wght": 400,
                  "slnt": 0
                }
              },
              "size": 17,
              "link": null
            }
          ]
        }
      ]
    },
