        {
          "id": "I148:459;147:266",
          "name": "Project story",
          "w": 1088,
          "h": 75,
          "text": "I conducted usability testing with a diverse group of users and gathered feedback on navigation, information clarity, and the overall experience. Testing identified confusing homepage navigation and friction when purchasing tickets and booking a visit. I used those insights to iterate on navigation and design elements, with the aim of making the experience easier to understand and use.",
          "font": {
            "family": "Inter",
            "style": "Regular",
            "variationSettings": {
              "wght": 400,
              "slnt": 0
            }
          },
          "size": 17,
