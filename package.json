    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@fontsource/instrument-serif": "^5.2.8",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/italianno": "^5.2.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "^7.13.0"
  },
  "devDependencies": {
    "@babel/parser": "^7.28.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "latest",
    "sharp": "^0.35.5",
    "typescript": "~5.9.3",
    "vite": "8.3.5"
  }
}
